{
  "name": "pets-agent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Enterprise WeChat connected Claude knowledge-base agent.",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "tsx src/harness/devServer.ts",
    "harness": "tsx src/harness/cli.ts",
    "smoke": "tsx src/smoke/regressionSmoke.ts",
    "smoke:deterministic": "tsx src/smoke/deterministicSmoke.ts",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "check": "npm run typecheck && npm run lint && npm run test && npm run build && npm run smoke:deterministic"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.156",
    "@earendil-works/pi-ai": "^0.75.5",
    "@earendil-works/pi-coding-agent": "^0.75.5",
    "@tencent-ai/agent-sdk": "^0.3.157",
    "@wecom/aibot-node-sdk": "^1.0.7",
    "better-sqlite3": "^12.10.0",
    "cron-parser": "^5.5.0",
    "dotenv": "^17.4.2",
    "fast-xml-parser": "^5.8.0",
    "fastify": "^5.8.5",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^25.9.1",
    "@vitest/coverage-v8": "^4.1.7",
    "eslint": "^10.4.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.4.2",
    "tsx": "^4.19.2",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.59.4",
    "vitest": "^4.1.7"
  }
}
