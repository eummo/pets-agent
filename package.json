{
  "name": "pets-agent",
  "version": "1.0.0",
  "type": "module",
  "description": "Agent orchestration extension for pi-coding-agent — spawn, manage and coordinate sub-agents",
  "piConfig": {
    "extensions": [
      "src/pets-agent-extension.ts"
    ]
  },
  "scripts": {
    "start": "pi --extension ./src/pets-agent-extension.ts",
    "dev": "pi --extension ./src/pets-agent-extension.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "js-yaml": "^4.1.0"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "^0.74.0",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^20.11.5",
    "tsx": "^4.7.0",
    "typebox": "^1.1.24",
    "typescript": "^5.3.3"
  }
}
